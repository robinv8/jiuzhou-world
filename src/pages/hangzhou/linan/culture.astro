---
import PageShell from '@/layouts/PageShell.astro'
import Culture from '@/views/Culture'
import { getPageSeo } from '@/lib/seo'

const seo = getPageSeo('/hangzhou/linan/culture')
const lang = 'zh' as const
---

<PageShell seo={seo} lang={lang}>
    <Culture lang={lang} volume="linan" />
</PageShell>
