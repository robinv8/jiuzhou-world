---
import PageShell from '@/layouts/PageShell.astro'
import ContributeHub from '@/views/ContributeHub'
import { getPageSeo } from '@/lib/seo'
import { localeStaticPaths } from '@/lib/i18n-path'
import { type Lang } from '@/i18n/config'

export function getStaticPaths() {
    return localeStaticPaths()
}

const lang = Astro.params.locale as Lang
const seo = getPageSeo('/contribute')
---

<PageShell seo={seo} lang={lang}>
    <ContributeHub lang={lang} />
</PageShell>
