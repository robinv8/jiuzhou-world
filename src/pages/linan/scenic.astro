---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { ScenicEntry } from '@/views/entries'
import { getPageSeo } from '@/lib/seo'

const seo = getPageSeo('/linan/scenic')
const lang = 'zh' as const
---

<BaseLayout seo={seo} lang={lang}>
    <ScenicEntry client:load lang={lang} />
</BaseLayout>
