---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { CultureEntry } from '@/views/entries'
import { getPageSeo } from '@/lib/seo'

const seo = getPageSeo('/linan/culture')
const lang = 'zh' as const
---

<BaseLayout seo={seo} lang={lang}>
    <CultureEntry client:load lang={lang} />
</BaseLayout>
